{
  "name": "yura",
  "private": true,
  "version": "0.1.0",
  "description": "Yura — an offline-first AI companion with a 3D face.",
  "license": "MIT",
  "scripts": {
    "dev": "npm --prefix ui run dev",
    "build": "npm --prefix ui run build",
    "preview": "npm --prefix ui run preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:windows": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc",
    "avatar:fetch": "node scripts/fetch-avatar.mjs",
    "test": "cargo test -p yura-core -p yura-llm -p yura-avatar -p yura-store",
    "typecheck": "npm --prefix ui run typecheck"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  }
}
